// Cloudflare Worker that serves the swarf-os download page and the ISO from R2 (ADR 0029).
// Deployed by .github/workflows/worker.yml; served on get.swarf-os.workers.dev (account subdomain swarf-os, ADR 0029).
{
  "name": "get",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [
    // The bucket was created in the EU jurisdiction (cannot be changed): the binding must say so.
    { "binding": "ISO", "bucket_name": "swarf-os-iso", "jurisdiction": "eu" }
  ]
}
